<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Admin</title>
</head>

<body
    style="
    font-family: Arial, sans-serif;
    background:#f5f7fb;
    padding:40px;
    margin:0;
    "
>

<% if (mensaje) { %>

    <div
        style="
        max-width:700px;
        margin:0 auto 20px auto;
        padding:15px;
        background:#dcfce7;
        color:#166534;
        border-radius:10px;
        text-align:center;
        font-weight:bold;
        "
    >
        <%= mensaje %>
    </div>

<% } %>

<div
    style="
    max-width:700px;
    margin:auto;
    background:white;
    padding:40px;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,.1);
    "
>

    <h1
        style="
        text-align:center;
        color:#1f2937;
        margin-bottom:30px;
        "
    >
        Panel Administrador
    </h1>

    <button
        onclick="window.location.href='<%= frontendUrl %>'"
        style="
        padding:12px 20px;
        border:none;
        border-radius:10px;
        background:#111827;
        color:white;
        cursor:pointer;
        margin-bottom:20px;
        font-weight:bold;
        "
    >
        Volver al sitio
    </button>

    <form
        action="/upload"
        method="POST"
        enctype="multipart/form-data"
        style="
        display:flex;
        flex-direction:column;
        gap:20px;
        "
    >

        <select
            name="categoria"
            style="
            padding:15px;
            border-radius:10px;
            border:1px solid #ddd;
            "
        >
            <option value="proyectos">Proyectos</option>
            <option value="metalicas">Metálicas</option>
            <option value="vias">Vías</option>
            <option value="topografia">Topografía</option>
            <option value="riego">Riego</option>
            <option value="urbanizacion">Urbanización</option>
        </select>

        <input
            type="file"
            name="imagen"
            style="
            padding:15px;
            border:1px solid #ddd;
            border-radius:10px;
            "
        >

        <button
            type="submit"
            style="
            padding:15px;
            border:none;
            border-radius:10px;
            background:#2563eb;
            color:white;
            font-weight:bold;
            cursor:pointer;
            "
        >
            Subir Archivo
        </button>

    </form>

</div>

<div
    style="
    max-width:1200px;
    margin:50px auto 0 auto;
    "
>

    <h2
        style="
        color:#1f2937;
        margin-bottom:20px;
        "
    >
        Archivos cargados
    </h2>

    <%
    const categorias = [
        "proyectos",
        "metalicas",
        "vias",
        "topografia",
        "riego",
        "urbanizacion"
    ];
    %>

    <% categorias.forEach(categoria => { %>

        <%
        const archivosCategoria = imagenes.filter(
            img => img.categoria === categoria
        );
        %>

        <details
            style="
            background:white;
            margin-bottom:20px;
            border-radius:15px;
            overflow:hidden;
            box-shadow:0 5px 15px rgba(0,0,0,.08);
            "
        >

            <summary
                style="
                padding:20px;
                cursor:pointer;
                font-size:18px;
                font-weight:bold;
                background:#111827;
                color:white;
                "
            >
                📁 <%= categoria.toUpperCase() %>
                (<%= archivosCategoria.length %> archivos)
            </summary>

            <div
                style="
                display:grid;
                grid-template-columns:repeat(auto-fill,minmax(250px,1fr));
                gap:20px;
                padding:20px;
                "
            >

                <% archivosCategoria.forEach(img => { %>

                    <div
                        style="
                        background:#f8fafc;
                        border-radius:12px;
                        padding:15px;
                        text-align:center;
                        box-shadow:0 2px 10px rgba(0,0,0,.08);
                        "
                    >

                        <%
                        const esVideo =
                            img.archivo.toLowerCase().endsWith(".mp4") ||
                            img.archivo.toLowerCase().endsWith(".mov") ||
                            img.archivo.toLowerCase().endsWith(".webm");
                        %>

                        <% if(esVideo){ %>

                            <video
                                controls
                                style="
                                width:100%;
                                height:180px;
                                object-fit:cover;
                                border-radius:10px;
                                "
                            >
                                <source
                                    src="/uploads/<%= img.categoria %>/<%= img.archivo %>"
                                >
                            </video>

                        <% } else { %>

                            <img
                                src="/uploads/<%= img.categoria %>/<%= img.archivo %>"
                                style="
                                width:100%;
                                height:180px;
                                object-fit:cover;
                                border-radius:10px;
                                "
                            >

                        <% } %>

                        <p
                            style="
                            margin-top:10px;
                            font-size:13px;
                            color:#374151;
                            word-break:break-all;
                            "
                        >
                            <%= img.archivo %>
                        </p>

                        <form
                            action="/eliminar"
                            method="POST"
                        >

                            <input
                                type="hidden"
                                name="categoria"
                                value="<%= img.categoria %>"
                            >

                            <input
                                type="hidden"
                                name="archivo"
                                value="<%= img.archivo %>"
                            >

                            <button
                                onclick="return confirm('¿Deseas eliminar este archivo?')"
                                style="
                                background:#dc2626;
                                color:white;
                                border:none;
                                padding:10px 18px;
                                border-radius:8px;
                                cursor:pointer;
                                font-weight:bold;
                                margin-top:10px;
                                "
                            >
                                Eliminar
                            </button>

                        </form>

                    </div>

                <% }) %>

            </div>

        </details>

    <% }) %>

</div>

</body>
</html>